# Copy to .env (gitignored) and fill in. The installer does the copy for you
# and generates the random passwords/secrets marked "auto".
# Never commit real values.

# --- Your business (used in prompts, emails, SMS and reports) ---
BUSINESS_NAME=Your Company
BUSINESS_REGION=your city or region
SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com
CALENDLY_URL=https://calendly.com/your-handle
# Default search location for the lead scripts (leave city blank for statewide)
DEFAULT_CITY=
DEFAULT_STATE=CA
# Where reports/CSVs are written (default: ./output)
OUTPUT_DIR=

# --- Anthropic (Claude relay; optional, Ollama works without it) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- HubSpot (CRM read/write) ---
HUBSPOT_TOKEN=

# --- Apollo (org enrichment, free plan = no people search) ---
APOLLO_KEY=

# --- Web search / scraping ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- Twilio (SMS) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# --- n8n (automation engine) ---
# Generate in n8n UI: Settings -> API -> Create API Key
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=auto
# Shared secret for inbound webhooks (X-Webhook-Token header)
N8N_WEBHOOK_SECRET=auto

# --- Postgres (Docker) ---
POSTGRES_USER=stack
POSTGRES_PASSWORD=auto
POSTGRES_DB=stack
# Host port for Docker Postgres (change if a local Postgres already uses 5432)
POSTGRES_PORT=5432

# --- SAM.gov (free key: sam.gov -> Account Details -> API Key) ---
SAM_GOV_API_KEY=

# --- ngrok (optional public tunnel to Open WebUI) ---
NGROK_AUTHTOKEN=

# --- Open WebUI ---
WEBUI_NAME=Local AI
OWUI_EMAIL=you@example.com
OWUI_PASSWORD=
WEBUI_SECRET_KEY=auto
# Token Open WebUI uses to call the pipelines container
OPENAI_API_KEY=auto

# --- Google Sheets MCP (OAuth, optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Gmail drafts (OAuth files from Google Cloud Console) ---
# Folder holding gcp-oauth.keys.json and credentials.json
GMAIL_CREDENTIALS_DIR=~/.gmail-mcp

# --- Search Console sitemap resubmit (optional) ---
# Comma-separated domains and the service account gcloud impersonates (keyless)
SITE_DOMAINS=example.com
GSC_SERVICE_ACCOUNT=sitemap-submitter@your-project.iam.gserviceaccount.com

# --- MCP bridge (mcpo) filesystem access: comma-separated folders ---
MCP_FS_ROOTS=~/Documents,~/Downloads,~/Desktop
